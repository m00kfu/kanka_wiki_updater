KANKA_TOKEN=your-kanka-personal-access-token
KANKA_CAMPAIGN_ID=12345

# Optional overrides (defaults shown)
# KANKA_BASE_URL=https://api.kanka.io/1.0
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# LMSTUDIO_MODEL=local-model
# SESSION_JOURNAL_TYPES=Session,One Shot,Draft   # comma-separated; leave empty for all types
# KANKA_REQUEST_INTERVAL=2.1
# DATA_DIR=~/.local/share/kanka_wiki_updater  # default
# DATA_DIR=./data                              # project-local (legacy)

# LLM provider selection ("lmstudio", "opencode", or "gemini")
# LLM_PROVIDER=lmstudio

# OpenCode Zen settings (only needed when LLM_PROVIDER=opencode)
# OPENCODE_API_KEY=your-opencode-api-key
# OPENCODE_MODEL=openai/gpt-oss-120b

# Gemini settings (only needed when LLM_PROVIDER=gemini)
# GEMINI_API_KEY=your-google-ai-studio-api-key
# GEMINI_MODEL=gemini-2.5-flash-latest
# GEMINI_TEMPERATURE=0.2
# GEMINI_MAX_TOKENS=4096
