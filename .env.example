KANKA_TOKEN=your-kanka-personal-access-token
KANKA_CAMPAIGN_ID=12345

# Optional overrides (defaults shown)
# KANKA_BASE_URL=https://api.kanka.io/1.0
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# LMSTUDIO_MODEL=local-model
# SESSION_JOURNAL_TYPE=Session
# KANKA_REQUEST_INTERVAL=2.1
# DATA_DIR=./data

# LLM provider selection ("lmstudio" or "gemini")
# LLM_PROVIDER=lmstudio

# Gemini settings (only needed when LLM_PROVIDER=gemini)
# GEMINI_API_KEY=your-google-ai-studio-api-key
# GEMINI_MODEL=gemini-2.5-flash-latest
# GEMINI_TEMPERATURE=0.2
# GEMINI_MAX_TOKENS=4096
